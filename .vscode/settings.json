{
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "editor.formatOnSave": true,
    "python.linting.enabled": true,
    "python.linting.flake8Enabled": true,
    "flake8.args": [
        "--max-line-length=100"
    ],
    "editor.rulers": [
        100
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    }
}